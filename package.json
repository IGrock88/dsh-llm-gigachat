{
  "name": "dsh-llm-gigachat",
  "version": "0.1.0",
  "description": "DeepSeek Harness (dsh) plugin that connects Sber GigaChat models: a built-in local OAuth proxy (client-credentials -> OpenAI-compatible endpoint, upstream serialization, legacy tool-calling translation) plus automatic provider-route bootstrap, so GigaChat appears on the standard Models settings page.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "examples",
    "README.md",
    "README.ru.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "gigachat",
    "sber",
    "giga-chat",
    "llm",
    "plugin"
  ],
  "author": "Igor Korobeynikov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igrock88/dsh-llm-gigachat.git"
  },
  "homepage": "https://github.com/igrock88/dsh-llm-gigachat#readme",
  "bugs": {
    "url": "https://github.com/igrock88/dsh-llm-gigachat/issues"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-credentials": "^0.1.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "license": "MIT"
}